  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============ COMPLANCE: AUDIT LOG ============

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  userRole        String   @default("")
  userName        String   @default("")
  action          String   @default("")          // create, update, delete, login, logout, status_change
  entityType      String   @default("")          // prescription, lab_billing, ipd_admission, ot_schedule, etc.
  entityId        String   @default("")
  description     String   @default("")          // human-readable summary
  beforeJson      String   @default("{}")        // old values snapshot
  afterJson       String   @default("{}")         // new values snapshot
  metadata        String   @default("{}")        // extra context (ip, ua, etc.)
  ipAddress       String   @default("")
  userAgent       String   @default("")
  severity        String   @default("info")     // info | warning | critical
  hospitalId      String?
  timestamp       DateTime @default(now())

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital        Hospital? @relation("AuditLogHospital", fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([severity, timestamp])
  @@index([hospitalId, timestamp])
  @@index([timestamp])
}

