// ============ INSURANCE: CLAIM ============

model InsuranceClaim {
  id              String   @id @default(cuid())
  claimNo         String   @default("")
  admissionId     String
  billId          String
  policyId        String
  companyId       String
  hospitalId      String
  tpaId           String?
  preAuthId       String?  @unique
  claimAmount     Float    @default(0)
  approvedAmount  Float    @default(0)
  patientPayable  Float    @default(0)
  tpaPayable      Float    @default(0)
  status          String   @default("Draft")
  submissionDate  DateTime?
  settlementDate  DateTime?
  settlementAmount Float   @default(0)
  settlementRef   String   @default("")
  deductions      String   @default("[]")
  notes           String   @default("")
