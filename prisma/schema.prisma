  claimId         String
  docType         String   @default("")
  fileUrl         String   @default("")
  fileName        String   @default("")
  uploadedBy      String
  createdAt       DateTime @default(now())

  claim           InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// ============================================================================
// EXTERNAL LAB PARTNER MODULE
// ============================================================================
// Represents external diagnostic centres that partner with doctors (not the
// in-house LabTechnician which is tied to a single Hospital). A LabPartner has
// its own login (User.role = "lab_partner"), maintains a test catalog with
// fees, receives ExternalTestOrders from doctors, uploads LabReportUpload
// files, and pays commission to the referring doctor via LabBilling /
// CommissionPayment records.
// ============================================================================

model LabPartner {
  id              String   @id @default(cuid())
  userId          String   @unique
  hospitalId      String?
  labName         String
  ownerName       String   @default("")
  email          String   @default("")
  mobile          String   @default("")
  altMobile       String   @default("")
  address         String   @default("")
  state           String   @default("")
  city            String   @default("")
  pincode         String   @default("")
  gstNo           String   @default("")
  registrationNo String   @default("")
  specializations String   @default("both") // blood | radiology | both
  testsAvailable  String   @default("[]") // JSON array of test names offered
  status          String   @default("Active") // Active | Inactive
  createdBy       String // User.id of admin or doctor who created this partner
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User                       @relation("LabPartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  hospital        Hospital?                  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  creator         User                       @relation("LabPartnerCreatedBy", fields: [createdBy], references: [id])
  doctorAssociations DoctorLabAssociation[]
  testCatalog     LabTestCatalog[]
  externalOrders  ExternalTestOrder[]
  reportUploads   LabReportUpload[]
  billings        LabBilling[]
  commissionPayments CommissionPayment[]

  @@index([hospitalId])
  @@index([status])
  @@index([createdBy])
}

model DoctorLabAssociation {
  id                String   @id @default(cuid())
  doctorId          String
  labPartnerId      String
  commissionPercent Float    @default(10)
  isActive          Boolean  @default(true)
  associatedAt      DateTime @default(now())
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctor            Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  labPartner        LabPartner @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)

  @@unique([doctorId, labPartnerId])
  @@index([labPartnerId, isActive])
}

model ExternalTestOrder {
  id            String    @id @default(cuid())
  orderNo       String    @unique @default(cuid())
  doctorId      String
  patientId     String
  labPartnerId  String
  bookingId     String?
  testName      String
  testType      String    @default("Blood") // Blood | Radiology | Pathology | Other
  testFee       Float     @default(0)
  status        String    @default("Ordered") // Ordered | InProgress | Completed | Cancelled
  urgency       String    @default("Normal") // Normal | Urgent
  orderedAt     DateTime  @default(now())
  completedAt   DateTime?
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User        @relation("ExternalOrderPatient", fields: [patientId], references: [id], onDelete: Cascade)
  labPartner    LabPartner  @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)
  booking       Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reportUploads LabReportUpload[]
  billing       LabBilling?

  @@index([doctorId, status])
  @@index([labPartnerId, status])
  @@index([patientId])
  @@index([bookingId])
}

model LabReportUpload {
  id                 String   @id @default(cuid())
  externalTestOrderId String
  labPartnerId       String
  fileUrl            String
  fileName           String   @default("")
  fileType           String   @default("") // mime type
  fileSize           Int      @default(0)
  reportData         String   @default("[]") // JSON: typed parameter results (for blood tests)
  uploadedAt         DateTime @default(now())
  uploadedBy         String
  verifiedByDoctor   Boolean  @default(false)
  verifiedAt         DateTime?
  notes              String   @default("")

  externalOrder      ExternalTestOrder @relation(fields: [externalTestOrderId], references: [id], onDelete: Cascade)
  labPartner         LabPartner        @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)

  @@index([externalTestOrderId])
  @@index([labPartnerId, uploadedAt])
}

model LabBilling {
  id                String   @id @default(cuid())
  labPartnerId      String
  doctorId          String
  patientId         String
  testOrderId       String   @unique
  amount            Float    @default(0)
  commissionAmount Float    @default(0)
  commissionPercent Float    @default(10)
  paymentStatus     String   @default("Pending") // Pending | Paid
  billedAt          DateTime @default(now())
  paidAt            DateTime?
  transactionRef    String   @default("")
  notes             String   @default("")

  labPartner        LabPartner @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)
  doctor            Doctor     @relation("DoctorLabBilling", fields: [doctorId], references: [id], onDelete: Cascade)
  externalOrder     ExternalTestOrder @relation(fields: [testOrderId], references: [id], onDelete: Cascade)

  @@index([labPartnerId, paymentStatus])
  @@index([doctorId, paymentStatus])
  @@index([patientId])
}

model CommissionPayment {
  id              String    @id @default(cuid())
  doctorId        String
  labPartnerId    String
  amount          Float     @default(0)
  period          String    @default("") // e.g. "2025-01"
  status          String    @default("Pending") // Pending | Paid
  requestedAt    DateTime  @default(now())
  paidAt         DateTime?
  transactionRef  String    @default("")
  notes           String    @default("")

  doctor          Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  labPartner      LabPartner @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
  @@index([labPartnerId, status])
  @@index([period])
}

model LabTestCatalog {
  id            String   @id @default(cuid())
  labPartnerId  String
  testName     String
  testCategory String   @default("Blood") // Blood | Radiology | Pathology | Other
  fee          Float    @default(0)
  sampleType   String   @default("")
  turnaroundTime String @default("") // e.g. "24 hours"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  labPartner   LabPartner @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)

  @@index([labPartnerId, isActive])
  @@index([testCategory])
}


model NotificationPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  mutedEvents            String   @default("[]") // JSON array of event types that should NOT toast/sound
  soundEnabled           Boolean  @default(true) // master sound toggle
  criticalChimeEnabled   Boolean  @default(true) // play chime on critical events
  emailDigest            String   @default("never") // never | daily | weekly
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id          String   @id @default(cuid())
  email       String
  codeHash    String   // bcrypt hash of the OTP — never store the OTP in plain text
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email, expiresAt])
  @@index([expiresAt])
}

// ─── Dr. Copilot (AI assistant) — doctor-scoped by design ─────────────────
// RULE #1 (DR-COPILOT-PLAN.md): every row and every query is scoped by
// doctorId. The LLM never gets raw DB access — it can only call the
// pre-built parameterized functions in src/lib/copilot/repo.ts, and the
// doctorId in those calls comes from the SESSION (never user input).
model CopilotChat {
  id        String   @id @default(cuid())
  doctorId  String // ← scope key: messages of one doctor are invisible to all others
  role      String // 'user' | 'assistant'
  content   String
  agentName String   @default("") // which agent produced this (router/query/summary…)
  metaJson  String   @default("{}") // citations (bookingIds), latency ms, etc.
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt])
}

model CopilotAction {
  id          String    @id @default(cuid())
  doctorId    String // ← scope key
  chatId      String?
  kind        String // 'rx_draft' | 'lab_order' | 'followup' | 'template'
  payloadJson String    @default("{}") // structured draft (approve-card content)
  status      String    @default("pending") // pending | approved | rejected | expired
  actedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([doctorId, status])
}
