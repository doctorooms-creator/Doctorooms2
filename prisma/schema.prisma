model IpdAdmission {
  id                      String                   @id @default(cuid())
  admissionNo             String                   @unique @default(cuid())
  hospitalId              String
  wardId                  String
  // Nullable + NOT unique: historical admissions keep no live bed pin.
  // Occupancy integrity is enforced at app level (409 when an Admitted
  // admission already holds the bed) — see bed-transfers + ipd/admit routes.
  bedId                   String?
  departmentId            String
  attendingDoctorId       String
  referringDoctorId       String?
  userId                  String?
  patientName             String                   @default("")
  patientAge              Int                      @default(0)
  patientGender           String                   @default("")
  patientDob              DateTime?
  bloodGroup              String                   @default("")
  maritalStatus           String                   @default("")
  occupation              String                   @default("")
  education               String                   @default("")
  religion                String                   @default("")
  aadharNo                String                   @default("")
  mobileNo                String                   @default("")
  idMarks                 String                   @default("")
  fatherName              String                   @default("")
  motherName              String                   @default("")
  husbandWifeName         String                   @default("")
  contactPersonName       String                   @default("")
  contactPersonMobile     String                   @default("")
  contactPersonRelation   String                   @default("")
  address                 String                   @default("")
  village                 String                   @default("")
  taluka                  String                   @default("")
  district                String                   @default("")
  state                   String                   @default("")
  pinCode                 String                   @default("")
  mlcCase                 Boolean                  @default(false)
  previousHospitalization String                   @default("")
  mediClaimDetails        String                   @default("")
  initialDiagnosis        String                   @default("")
  opdBookingId            String?                  @unique
  chiefComplaints         String                   @default("")
  informant               String                   @default("")
  pastHistory             String                   @default("")
  personalHistory         String                   @default("{}")
  habits                  String                   @default("{}")
  femaleHistory           String                   @default("{}")
  drugHistory             String                   @default("")
  consciousnessLevel      String                   @default("Conscious")
  obeyingCommands         Boolean                  @default(true)
  respondingToDPS         Boolean                  @default(true)
  oriented                Boolean                  @default(true)
  speech                  String                   @default("Normal")
  examinationNotes        String                   @default("")
  generalSigns            String                   @default("{}")
  admissionDate           DateTime                 @default(now())
  admissionTime           String                   @default("")
  status                  String                   @default("Admitted")
  dischargeDate           DateTime?
  dischargeTime           String                   @default("")
  dischargeType           String                   @default("")
  finalDiagnosis          String                   @default("")
  dischargeSummary        String                   @default("")
  roomRentDays            Int                      @default(0)
  totalBillAmount         Float                    @default(0)
  advanceAmount           Float                    @default(0)
  estimatedBill           Float                    @default(0)
  paymentStatus           String                   @default("Pending")
  dischargeAdvised        Boolean                  @default(false)
  followUpDate            DateTime?
  followUpNotes           String                   @default("")
  admittedBy              String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bedTransfers            BedTransfer[]
  dietOrders              DietOrder[]
  doctorOrders            DoctorOrder[]
  doctorVisits            DoctorVisit[]
  familyAccess            FamilyAccess?
  investigationReports    InvestigationReport[]
  preAuths                InsurancePreAuth[]
  insuranceClaims         InsuranceClaim[]
  attendingDoctor         Doctor                   @relation("AdmittingDoctor", fields: [attendingDoctorId], references: [id])
  bed                     Bed?                     @relation(fields: [bedId], references: [id])
  department              Department               @relation(fields: [departmentId], references: [id])
  hospital                Hospital                 @relation(fields: [hospitalId], references: [id])
  opdBooking              Booking?                 @relation("IpdFromOpd", fields: [opdBookingId], references: [id], onDelete: Restrict)
  referringDoctor         Doctor?                  @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])
  patient                 User?                    @relation(fields: [userId], references: [id])
  ward                    Ward                     @relation(fields: [wardId], references: [id])
  bill                    IpdBill?
  medicineAdministrations MedicineAdministration[]
  nurseAssignments        NursePatientAssignment[]
  otSchedules             OtSchedule[]
  advances                PatientAdvance[]
  sampleCollections       SampleCollection[]
  vitalRecords            VitalRecord[]

  @@index([hospitalId, status])
  @@index([wardId, status])
  @@index([bedId])
  @@index([attendingDoctorId])
}

