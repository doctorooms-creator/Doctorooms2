generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // system-level DATABASE_URL=file:... that overrides the .env file.
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(cuid())
  name                       String
  gender                     String                      @default("Male")
  role                       String                      @default("patient")
  status                     String                      @default("Pending")
  email                      String                      @unique
  password                   String                      @default("")
  profileImg                 String                      @default("default.png")
  mobileNo                   String                      @default("")
  mobileVerifiedAt           DateTime?
  emailVerifiedAt            DateTime?
  settingsJson               String                      @default("{}")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  bookings                   Booking[]
  chatMessages               BookingChat[]               @relation("ChatSender")
  receivedChats              BookingChat[]               @relation("ChatReceiver")
  doctor                     Doctor?
  assistantProfile           DoctorAssistant?            @relation("AssistantUser")
  pharmacistProfile          DoctorPharmacist?           @relation("PharmacistUser")
  receivedRatings            DoctorRating[]              @relation("DoctorRatings")
  sentRatings                DoctorRating[]              @relation("PatientRatings")
  hospital                   Hospital?
  inquiries                  HospitalInquiry[]
  ipdAdmissions              IpdAdmission[]
  labReportsOrdered          LabReport[]                 @relation("LabReportOrderedBy")
  labReportsAsPatient        LabReport[]                 @relation("LabReportPatient")
  labPartnerProfile          LabPartner?                 @relation("LabPartnerUser")
  labPartnersCreated         LabPartner[]                @relation("LabPartnerCreatedBy")
  externalTestOrdersAsPatient ExternalTestOrder[]        @relation("ExternalOrderPatient")
  labTechnicianProfile       LabTechnician?              @relation("LabTechUser")
  medicalDocuments           MedicalDocument[]
  notifications              Notification[]
  opdBills                   OpdBill[]
  posts                      Post[]
  assistedPrescriptions      Prescription[]              @relation("PrescriptionAssistant")
  prescriptionAccessRequests PrescriptionAccessRequest[] @relation("PrescriptionAccessPatient")
  receptionistProfile        Receptionist?               @relation("ReceptionistUser")
  nurseProfile               StaffNurse?                 @relation("NurseUser")
  sessions                   Session[]
  insurancePolicies          PatientInsurancePolicy[]
  auditLogs                  AuditLog[]
  notificationPreference     NotificationPreference?
}

model Doctor {
  id                       String                      @id @default(cuid())
  userId                   String                      @unique
  bookingDays              Int                         @default(180)
  dailyLimit               Int                         @default(50)
  doctorType               String                      @default("")
  description              String                      @default("")
  photos                   String                      @default("[]")
  address                  String                      @default("")
  state                    String                      @default("")
  city                     String                      @default("")
  hospitalAddress          String                      @default("")
  fees                     Float                       @default(0)
  emergencyCharge          Float                       @default(0)
  specialization           String                      @default("")
  awardAndRecognition      String                      @default("")
  education                String                      @default("")
  lat                      Float                       @default(0)
  longi                    Float                       @default(0)
  hospitalId               String?
  experience               String                      @default("")
  registrationDetail       String                      @default("")
  contactNo                String                      @default("")
  phoneNo                  String                      @default("")
  isEmergency              Boolean                     @default(false)
  queuePaused              Boolean                     @default(false)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  bookings                 Booking[]
  categories               CategoryMaster[]
  coMaster                 CoMaster[]
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistants               DoctorAssistant[]
  gallery                  DoctorGallery[]
  holidays                 DoctorHoliday[]
  hospitalLinks            DoctorHospital[]
  medicines                DoctorMedicine[]
  doctorOrders             DoctorOrder[]
  pharmacistLinks          DoctorPharmacist[]
  schedules                DoctorSchedule[]
  doctorVisits             DoctorVisit[]
  findings                 FindingsMaster[]
  ipdAdmissionsAsAttending IpdAdmission[]              @relation("AdmittingDoctor")
  ipdAdmissionsAsReferring IpdAdmission[]              @relation("ReferringDoctor")
  labReports               LabReport[]                 @relation("DoctorLabReports")
  labAssociations         DoctorLabAssociation[]
  externalTestOrders      ExternalTestOrder[]
  labBillings             LabBilling[]                 @relation("DoctorLabBilling")
  commissionPayments      CommissionPayment[]
  labelMaster              LabelMaster[]
  otSurgeries              OtSchedule[]
  otherSettings            POtherSetting?
  prescriptions            Prescription[]
  accessRequestsReceived   PrescriptionAccessRequest[] @relation("OriginalDoctor")
  accessRequestsMade       PrescriptionAccessRequest[] @relation("RequestingDoctor")
  rxTemplates              PrescriptionTemplate[]
  questionMaster           QuestionsMaster[]
  receptionistLinks        Receptionist[]
  sampleCollections        SampleCollection[]
  tableTemplates           TableTemplateMaster[]

  // SECURITY (P4.7): Add indexes for doctor search/filter queries.
  @@index([specialization])
  @@index([city])
  @@index([state])
}

model Hospital {
  id                String             @id @default(cuid())
  userId            String             @unique
  hospitalName      String             @default("")
  address           String             @default("")
  state             String             @default("")
  city              String             @default("")
  pincode           String             @default("")
  email             String             @default("")
  contactNo         String             @default("")
  website           String             @default("")
  image             String             @default("")
  about             String             @default("")
  hospitalType      String             @default("Multi-Specialty")
  establishedYear   Int                @default(0)
  bedCount          Int                @default(0)
  accreditation     String             @default("")
  facilities        String             @default("[]")
  gallery           String             @default("[]")
  lat               Float              @default(0)
  longi             Float              @default(0)
  status            String             @default("Active")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chargeCategories  ChargeCategory[]
  chargeItems       ChargeItem[]
  departments       Department[]
  dietOrders        DietOrder[]
  doctorLinks       DoctorHospital[]
  pharmacists       DoctorPharmacist[]
  familyAccesses    FamilyAccess[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItems    InventoryItem[]
  ipdAdmissions     IpdAdmission[]
  ipdBills          IpdBill[]
  labReports        LabReport[]
  labTechnicians    LabTechnician[]
  labTestMasters    LabTestMaster[]
  labPartners       LabPartner[]
  opdBills          OpdBill[]
  operationTheaters OperationTheater[]
  otSchedules       OtSchedule[]
  purchaseOrders    PurchaseOrder[]
  receptionists     Receptionist[]
  shiftHandovers    ShiftHandover[]
  nurses            StaffNurse[]
  stockMovements    StockMovement[]
  wards             Ward[]
  paymentTransactions PaymentGatewayTransaction[]
  notificationLogs  NotificationLog[]
  notificationTemplates NotificationTemplate[]
  vendors           Vendor[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  vendorPayments    VendorPayment[]
  preAuths          InsurancePreAuth[]
  insuranceClaims   InsuranceClaim[]
  auditLogs          AuditLog[]                 @relation("AuditLogHospital")
}

model Department {
  id            String           @id @default(cuid())
  hospitalId    String
  name          String           @default("")
  nameHi        String           @default("")
  shortCode     String           @default("")
  description   String           @default("")
  icon          String           @default("")
  floorNo       String           @default("")
  opdRoom       String           @default("")
  status        String           @default("Active")
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  hospital      Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorLinks   DoctorHospital[]
  ipdAdmissions IpdAdmission[]
  receptionists Receptionist[]
}

model DoctorHospital {
  id           String     @id @default(cuid())
  doctorId     String
  hospitalId   String
  departmentId String
  designation  String     @default("")
  fees         Float      @default(0)
  opdTimings   String     @default("")
  isAvailable  Boolean    @default(true)
  status       String     @default("Active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([doctorId, hospitalId, departmentId])
}

model Booking {
  id                   String         @id @default(cuid())
  appointmentNo        String         @unique @default(cuid())
  doctorId             String?
  userId               String?
  state                String         @default("")
  city                 String         @default("")
  bookingDate          DateTime       @default(now())
  patientName          String         @default("")
  disease              String         @default("")
  description          String         @default("")
  gender               String         @default("")
  dateOfBirth          DateTime?
  age                  Int?
  relationWithMe       String         @default("")
  bloodGroup           String         @default("")
  weight               Float          @default(0)
  height               Float          @default(0)
  physicallyChallenged String         @default("No")
  status               String         @default("Pending")
  timeSlot             String         @default("")
  bookingMode          String         @default("InPerson")
  videoRoomId          String         @default("")
  bookingType          String         @default("By Self")
  appointmentCharge    Float          @default(0)
  hospitalId           String?
  departmentId         String?
  tokenNumber          String         @default("")
  tokenOrder           Int            @default(0)
  isEmergency          Boolean        @default(false)
  receptionistId       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  doctor               Doctor?        @relation(fields: [doctorId], references: [id])
  user                 User?          @relation(fields: [userId], references: [id])
  chatMessages         BookingChat[]
  ipdAdmission         IpdAdmission?  @relation("IpdFromOpd")
  opdBills             OpdBill?
  prescriptions        Prescription[]
  externalTestOrders   ExternalTestOrder[]

  @@index([hospitalId, status])
  @@index([doctorId, status])
  @@index([userId, status])
  @@index([doctorId, bookingDate, status])
  @@index([hospitalId, bookingDate, status])
  @@index([doctorId, bookingDate, tokenOrder])
  @@index([bookingDate, status, bookingType])

  // SECURITY (P1.5): Prevent double-booking race condition.
  // Only one booking per (doctor, date, slot, status) — so a doctor can have
  // at most 1 Pending + 1 Approve + 1 Visited etc. for the same slot.
  // The race condition in /api/patient/bookings POST now fails at the DB
  // layer (Prisma P2002 error) instead of allowing duplicates.
  // @@unique([doctorId, bookingDate, timeSlot, status]) — temporarily disabled for migration. Clean up duplicate bookings before re-enabling.
}

model BookingChat {
  id        String   @id @default(cuid())
  bookingId String
  fromId    String
  toId      String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation("ChatSender", fields: [fromId], references: [id])
  receiver  User     @relation("ChatReceiver", fields: [toId], references: [id])
}

model Prescription {
  id                String                      @id @default(cuid())
  bookingId         String
  patientName       String                      @default("")
  patientAge        String                      @default("")
  disease           String                      @default("")
  weight            String                      @default("")
  bp                String                      @default("")
  temperature       String                      @default("")
  description       String                      @default("")
  status            String                      @default("Draft")
  fulfillmentStatus String                      @default("Pending")
  nextVisit         DateTime?
  assistantId       String?
  packedBy          String?
  packedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  doctorId          String
  chiefComplaints   PCo[]
  diagnosisTables   PDignoTable[]
  labels            PLabel[]
  medicines         PMedicine[]
  suggestions       PSuggestion[]
  assistant         User?                       @relation("PrescriptionAssistant", fields: [assistantId], references: [id])
  booking           Booking                     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctor            Doctor                      @relation(fields: [doctorId], references: [id])
  accessRequests    PrescriptionAccessRequest[]
}

model PMedicine {
  id             String       @id @default(cuid())
  prescriptionId String
  medicine       String       @default("")
  morning        Int          @default(0)
  afternoon      Int          @default(0)
  evening        Int          @default(0)
  tab            Int          @default(1)
  dose           String       @default("")
  description    String       @default("")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PLabel {
  id             String       @id @default(cuid())
  prescriptionId String
  label          String       @default("")
  labelEn        String       @default("")
  value          String       @default("")
  labelUnit      String       @default("")
  showUnit       Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PSuggestion {
  id             String       @id @default(cuid())
  prescriptionId String
  // Complaint (CoMaster id) this advice belongs to; null = general advice.
  coId           String?
  question       String       @default("")
  questionEn     String       @default("")
  suggestions    String       @default("")
  suggestionsEn  String       @default("")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PDignoTable {
  id             String       @id @default(cuid())
  prescriptionId String
  templateId     String?
  rows           Int          @default(3)
  cols           Int          @default(2)
  headerLabel    String       @default("[]")
  colsLabel      String       @default("[]")
  footerLabel    String       @default("[]")
  extraLabel     String       @default("")
  // Typed cell data, JSON object keyed "row-col" (e.g. {"0-1": "Normal"}).
  cellValues     String?      @default("[]")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PCo {
  id             String       @id @default(cuid())
  prescriptionId String
  coId           String
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model POtherSetting {
  id            String   @id @default(cuid())
  doctorId      String   @unique
  logo          String   @default("")
  time          String   @default("{}")
  header        String   @default("")
  fullHeader    String   @default("")
  isFullHeader  Boolean  @default(false)
  footer        String   @default("")
  showCoInPrint Boolean  @default(true)
  showNextVisit Boolean  @default(true)
  printLayout   String   @default("standard")
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model DoctorRating {
  id                 String   @id @default(cuid())
  patientId          String
  doctorId           String
  bookingId          String?
  star               Int      @default(5)
  consultationRating Int      @default(0)
  waitTimeRating     Int      @default(0)
  staffRating        Int      @default(0)
  review             String   @default("")
  wouldRecommend     Boolean  @default(true)
  isAnonymous        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  doctor             User     @relation("DoctorRatings", fields: [doctorId], references: [id])
  patient            User     @relation("PatientRatings", fields: [patientId], references: [id])
}

model DoctorSchedule {
  id           String   @id @default(cuid())
  doctorId     String
  day          String
  startTime    String   @default("09:00")
  endTime      String   @default("17:00")
  slotDuration Int      @default(30)
  timeSlots    String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model DoctorHoliday {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  remark    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorMedicine {
  id          String             @id @default(cuid())
  name        String             @default("")
  morning     Int                @default(0)
  afternoon   Int                @default(0)
  evening     Int                @default(0)
  dose        String             @default("[]")
  tab         Int                @default(1)
  description String             @default("")
  status      String             @default("Active")
  createdById String?
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  doctor      Doctor             @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings    FindingsMedicine[]
}

model CategoryMaster {
  id          String     @id @default(cuid())
  name        String     @default("")
  nameEn      String     @default("")
  status      String     @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  doctor      Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  complaints  CoMaster[]
}

model FindingsMaster {
  id          String             @id @default(cuid())
  name        String             @default("")
  nameEn      String             @default("")
  status      String             @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  doctor      Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicines   FindingsMedicine[]
}

model FindingsMedicine {
  id          String         @id @default(cuid())
  findingId   String
  medicineId  String
  dose        String         @default("")
  morning     Int            @default(0)
  afternoon   Int            @default(0)
  evening     Int            @default(0)
  tab         Int            @default(0)
  description String         @default("")
  createdAt   DateTime       @default(now())
  finding     FindingsMaster @relation(fields: [findingId], references: [id], onDelete: Cascade)
  medicine    DoctorMedicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([findingId, medicineId])
}

model TableTemplateMaster {
  id          String   @id @default(cuid())
  name        String   @default("")
  rows        Int      @default(3)
  cols        Int      @default(2)
  headerLabel String   @default("[]")
  colsLabel   String   @default("[]")
  footerLabel String   @default("[]")
  extraLabel  String   @default("")
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model DoctorAssistant {
  id          String   @id @default(cuid())
  userId      String   @unique
  doctorId    String
  description String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user        User     @relation("AssistantUser", fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorPharmacist {
  id          String    @id @default(cuid())
  userId      String    @unique
  doctorId    String?
  hospitalId  String?
  description String    @default("")
  address     String    @default("")
  dlNo        String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  doctor      Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user        User      @relation("PharmacistUser", fields: [userId], references: [id], onDelete: Cascade)
}

model Receptionist {
  id           String      @id @default(cuid())
  userId       String      @unique
  doctorId     String?
  hospitalId   String
  departmentId String?
  address      String      @default("")
  createdAt    DateTime    @default(now())
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  doctor       Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user         User        @relation("ReceptionistUser", fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorTypeMaster {
  id        String   @id @default(cuid())
  type      String   @default("")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String   @default("")
  permalink String   @unique @default(cuid())
  content   String   @default("")
  blogImg   String   @default("")
  videoLink String   @default("")
  type      String   @default("Blog")
  status    String   @default("Draft")
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  message   String   @default("")
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Slider {
  id          String   @id @default(cuid())
  sliderImage String   @default("")
  position    Int      @default(0)
  status      String   @default("Active")
  link        String   @default("")
  title       String   @default("")
  subtitle    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HospitalInquiry {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  department String  @default("")
  subject   String   @default("")
  message   String   @default("")
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model DiseaseMaster {
  id        String   @id @default(cuid())
  name      String   @default("")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabelMaster {
  id          String   @id @default(cuid())
  label       String   @default("")
  labelEn     String   @default("")
  unit        String   @default("")
  showUnit    Boolean  @default(true)
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model CoMaster {
  id          String            @id @default(cuid())
  coCode      String            @default("")
  coDetail    String            @default("")
  coDetailEn  String            @default("")
  categoryId  String?
  status      String            @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    CategoryMaster?   @relation(fields: [categoryId], references: [id])
  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  questions   QuestionsMaster[] @relation("QuestionCo")
}

model QuestionsMaster {
  id          String              @id @default(cuid())
  question    String              @default("")
  questionEn  String              @default("")
  explanation String              @default("")
  coId        String?
  status      String              @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  co          CoMaster?           @relation("QuestionCo", fields: [coId], references: [id])
  doctor      Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  suggestions SuggestionsMaster[]
}

model SuggestionsMaster {
  id            String          @id @default(cuid())
  questionId    String
  suggestions   String          @default("")
  suggestionsEn String          @default("")
  status        String          @default("Active")
  createdById   String?
  doctorId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  question      QuestionsMaster @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model DoctorGallery {
  id        String   @id @default(cuid())
  doctorId  String
  image     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model PrescriptionAccessRequest {
  id                 String       @id @default(cuid())
  prescriptionId     String
  requestingDoctorId String
  patientId          String
  originalDoctorId   String
